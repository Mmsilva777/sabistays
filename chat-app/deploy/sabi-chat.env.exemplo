# Copiar para /etc/sabi-chat.env (chmod 600) e preencher.
# Chave da API da Anthropic (console.anthropic.com > API keys). Sem ela o chat funciona, mas o Claude não responde.
ANTHROPIC_API_KEY=
# Endereço público do chat (usado nos links de convite).
URL_PUBLICO=https://chat.sabistays-sal.com
# Onde ficam as mensagens, os membros e o contexto do Claude.
DADOS=/var/lib/sabi-chat
# Limite de gasto do Claude por mês, em dólares. Ao chegar ao limite, o Claude deixa de responder até ao mês seguinte.
CLAUDE_LIMITE_MENSAL_USD=25
# Opcional: modelo, esforço (low | medium | high), número de mensagens que o Claude lê, pesquisa na web (1 ligada, 0 desligada).
# CLAUDE_MODELO=claude-opus-5-5
# CLAUDE_ESFORCO=medium
# CLAUDE_HISTORICO=120
# CLAUDE_PESQUISA_WEB=1
# Ficheiros enviados no chat: tamanho máximo de cada um e espaço total (MB).
# FICHEIROS_MAX_MB=50
# FICHEIROS_TOTAL_MB=3000
# Arquivo automático por temas: corre a cada N mensagens novas ou após X minutos sem conversa.
# ARQUIVO_LOTE=25
# ARQUIVO_PAUSA_MIN=10
PORT=8787
HOST=127.0.0.1
